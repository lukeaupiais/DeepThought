  "rubric": [
    {
      "id": "D1",
      "point": "Optional delete preserves third-party compatibility",
      "evidence": [
        {
          "file": "libs/deepagents/deepagents/backends/protocol.py",
          "start_line": 666,
          "end_line": 696,
          "expected": "delete is optional concrete default raising NotImplementedError, not abstract; a backend without an override remains instantiable. Making it mandatory breaks external legacy backends."
        }
      ]
    },
    {
