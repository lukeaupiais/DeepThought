          "file": "libs/deepagents/deepagents/backends/filesystem.py",
          "start_line": 583,
          "end_line": 616,
          "expected": "symlinks unlinked without following; directories rmtree; failures returned and recursive deletion may partially succeed."
        },
        {
          "file": "libs/deepagents/deepagents/backends/sandbox.py",
          "start_line": 1368,
          "end_line": 1410,
          "expected": "probe absent path, rm -rf, unknown exit status handled explicitly and errors returned. A universal implementation cannot discard these semantics."
        }
      ]
    },
    {
      "id": "D8",
      "point": "Results and permission checks must survive the rollout",
      "evidence": [
        {
          "file": "libs/deepagents/deepagents/backends/protocol.py",
          "start_line": 305,
          "end_line": 319,
