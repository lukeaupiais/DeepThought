          "expected": "exact key plus slash-prefix descendants, queue dict.fromkeys(to_delete,None) using _send_files_update; return DeleteResult(path) instead of returning file-state payload."
        },
        {
          "file": "libs/deepagents/deepagents/backends/state.py",
          "start_line": 98,
